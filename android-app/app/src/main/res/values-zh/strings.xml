    <!-- Intro screen -->
    <string name="intro_tagline">一个可以对话的计算器</string>
    <string name="intro_body">LangCalc 可以把您说出或输入的请求(支持中文和英文)转换成一次计算。一个专门为函数调用微调过的小型语言模型(FunctionGemma)会读取您的请求并选择正确的运算。全部计算都在本机完成,不会发送到服务器。</string>
    <string name="intro_model_label">模型</string>
    <string name="intro_model_name">FunctionGemma(微调版,2.7 亿参数,约 %1$s)</string>
